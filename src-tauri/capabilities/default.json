{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Buddy, panel, bubble, and editor windows: the frontend drives everything through app commands (toggle_panel, close_panel, start_buddy_drag, …); window geometry and visibility are managed Rust-side, so no core:window IPC grants are needed. Region selection runs in the overlay window, which likewise drives everything through app commands. build.rs's non-empty AppManifest command list makes EVERY custom command in generate_handler! capability-gated app-wide (tauri's RuntimeAuthority::has_app_acl), not just the editor_* ones Task 11 set out to scope -- so every command that is not an editor_* command needs its own allow-<kebab-case> grant below, or every window loses it. The editor_* commands are the one deliberate exception: NOT granted here, granted only by capabilities/editor.json to the editor window alone (Task 11, R8's app-manifest half; editor::capability_guard, test-only, pins the partition both ways).",
  "windows": ["main", "panel", "bubble", "overlay", "editor",
    "region-indicator"],
  "permissions": [
    "core:default",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
